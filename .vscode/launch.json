{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🐛 Debug Backend Server",
      "program": "${workspaceFolder}/backend/node_modules/ts-node/dist/bin.js",
      "args": [
        "--project",
        "${workspaceFolder}/backend/tsconfig.backend.json",
        "${workspaceFolder}/backend/server.ts"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "🔗 Attach to Running Server",
      "port": 9229,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}